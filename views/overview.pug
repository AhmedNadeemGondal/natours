extends base

block content
  main.main
    // OVERLAY
    #recruiter-overlay.overlay
      .overlay-content
        h2 Welcome to Natours!
        p This is the server-side rendered frontend for showcasing API capabilities and rendering engine implementation.
        h3 This is deployed as a
          |
          strong vercel
          | serverless function so the site is a bit slow to respond
        p
          | You can log in using:
          br
          strong User:
          |
          | laura@example.com
          br
          strong Admin:
          |
          | admin@natours.io
          br
          strong Password:
          |
          | test1234 (for both)
        p
        p
          | Please click the
          |
          u
            mark instruction icon
          |
          | on the navbar to view these credentials again
        p
          | Explore the API Documentation:
          a(
            href='https://documenter.getpostman.com/view/40971390/2sAYX8J1r5#4f3402aa-801f-4bf7-b9eb-9b65b91324a3',
            target='_blank'
          ) View API Docs
        p
          | Access the GitHub Repository:
          a(
            href='https://github.com/AhmedNadeemGondal/natours',
            target='_blank'
          ) View on GitHub
        button.overlay-close(
          onclick='document.getElementById("recruiter-overlay").style.display="none"'
        ) Close

    .card-container
      each tour in tours
        .card
          .card__header
            .card__picture
              .card__picture-overlay &nbsp;
              img.card__picture-img(
                src=`img/tours/${tour.imageCover}`,
                alt=`${tour.name}`
              )
            h3.heading-tertirary
              span= tour.name

          .card__details
            h4.card__sub-heading= `${tour.difficulty} ${tour.duration}-day tour`
            p.card__text= tour.summary
            .card__data
              svg.card__icon
                use(xlink:href='img/icons.svg#icon-map-pin')
              span= tour.startLocation.description
            .card__data
              svg.card__icon
                use(xlink:href='img/icons.svg#icon-calendar')
              span= tour.startDates[0].toLocaleDateString('en-us', { month: 'long', year: 'numeric' })
            .card__data
              svg.card__icon
                use(xlink:href='img/icons.svg#icon-flag')
              span= `${tour.locations.length} stops`
            .card__data
              svg.card__icon
                use(xlink:href='img/icons.svg#icon-user')
              span= `${tour.maxGroupSize} people`

          .card__footer
            p
              span.card__footer-value= `$${tour.price} `
              |
              span.card__footer-text per person
            p.card__ratings
              span.card__footer-value= tour.ratingsAverage
              |
              span.card__footer-text= ` rating (${tour.ratingsQuantity})`
            a.btn.btn--green.btn--small(href=`/tour/${tour.slug}`) Details
